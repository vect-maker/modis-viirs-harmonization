FIRMS_MAP_KEY=your_firms_map_key_here

# Caddy site address in production (compose.yml)
# Use a domain name for automatic HTTPS, or :80 for HTTP-only by IP
CADDY_DOMAIN=localhost

# Frontend API base URL (baked at build time for prod, injected at runtime in dev container)
VITE_API_BASE_URL=/api

# Primary PostgreSQL / PostGIS connection URI (for host-side CLI tools)
# Local Podman default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firms?sslmode=prefer

# Optional external PostgreSQL override for compose.yml (e.g. Azure PostgreSQL Flexible Server):
# EXTERNAL_DATABASE_URL=postgresql+psycopg://admin:password@my-server.postgres.database.azure.com:5432/firms?sslmode=require

# Local Podman container initialization variables (only used by compose.yml on initial boot)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firms
POSTGRES_PORT=5432

# NATS JetStream & SSE multi-replica presence
NATS_URL=nats://localhost:4222
SSE_PRESENCE_TTL_SECONDS=45
FIRMS_AREA_BBOX=-92.3,7.2,-77.1,18.5
FIRMS_COUNTRY_NAME=Central_America
CATCHUP_COOLDOWN_SECONDS=610
NRT_POLL_INTERVAL_SECONDS=300
