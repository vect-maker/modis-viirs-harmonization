set dotenv-load
set positional-arguments

# List available frontend recipes
default:
    @just --list

# Install npm dependencies
install:
    npm install

# Run Vite development server
dev:
    npm run dev

# Run full production build with type checking
build:
    npm run build

# Run TypeScript type check
typecheck:
    npm run type-check

# Run linters (oxlint and eslint)
lint:
    npm run lint

# Format code with prettier
format:
    npm run format

# Build production static frontend container image
build-prod:
    podman build -t localhost/firms-frontend:prod -f prod.containerfile .

# Build debug/dev frontend container image (expects source mounted at /app)
build-debug:
    podman build -t localhost/firms-frontend:debug -f debug.containerfile .
