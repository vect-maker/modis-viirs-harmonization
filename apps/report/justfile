# List available recipes
default:
    @just --list

# Compile the Typst report to PDF inside output/
build:
    mkdir -p output
    typst compile main.typ output/report.pdf

# Export page PNGs to output/temp/ for visual layout inspection
preview:
    mkdir -p output/temp
    typst compile main.typ "output/temp/page-{p}.png" -f png

# Watch and recompile on changes
watch:
    mkdir -p output
    typst watch main.typ output/report.pdf

# Remove generated output artifacts
clean:
    rm -rf output report.pdf
