set dotenv-load
set positional-arguments

# List available recipes
default:
    @just --list

# Create virtual environment with uv and install dependencies
setup-env:
    uv venv
    uv pip install -r requirements.txt

# Refresh metadata
sync-meta:
    uv run pipeline/sync_meta.py

# Transform metadata
transform-meta:
    uv run pipeline/transform_meta.py

# Reset database and re-populate metadata from scratch
reset-db:
    rm -f data/pipeline.db
    uv run pipeline/transform_meta.py

# Fetch archive files from NASA FIRMS and convert to Parquet
fetch-data *args:
    uv run pipeline/fetcher.py {{args}}

# Synchronize downloaded Parquet files on disk with pipeline tracking database
sync-local-files:
    uv run pipeline/sync_local_files.py

# Fuse raw archive Parquet files into a unified Silver dataset (scope: central_america | all)
fuse-data scope="central_america":
    mkdir -p data/processed data/temp/duckdb
    duckdb -dark-mode -c "SET VARIABLE fuse_scope = '{{scope}}';" -c ".read sql/fuse_datasets.sql"

# Apply universal spatio-temporal MODIS-VIIRS harmonization to Silver dataset
harmonize-data:
    mkdir -p data/processed data/temp/duckdb data/temp/harmonize
    for f in sql/harmonize/*.sql; do \
        echo "Running $f..."; \
        duckdb -dark-mode -f "$f" || exit 1; \
    done
    rm -rf data/temp/harmonize

# Run a single harmonization step by filename prefix (e.g. just harmonize-step 01)
harmonize-step step:
    mkdir -p data/processed data/temp/duckdb data/temp/harmonize
    duckdb -dark-mode -f sql/harmonize/{{step}}*.sql

# Normalize harmonized Silver dataset into Star Schema Gold Parquet datasets with deterministic UUIDv5 keys
normalize-data:
    mkdir -p data/processed/star data/temp/duckdb
    duckdb -dark-mode -f sql/normalize_star_schema.sql

# Export a sample slice of Nicaragua 2024 hotspots as JSON for the frontend
export-sample limit="5000":
    mkdir -p ../frontend/src/data
    duckdb -dark-mode -c "COPY ( \
      SELECT \
        latitude, \
        longitude, \
        strftime(acq_datetime, '%Y-%m-%d %H:%M:%S') AS acq_datetime, \
        instrument, \
        satellite, \
        confidence_class, \
        confidence, \
        frp, \
        bright_mir, \
        daynight \
      FROM 'data/processed/hotspots.parquet' \
      WHERE acq_datetime >= '2024-03-01' AND acq_datetime <= '2024-05-31' \
      ORDER BY acq_datetime DESC \
      LIMIT {{limit}} \
    ) TO '../frontend/src/data/sample_hotspots.json' (FORMAT JSON, ARRAY true);"
    @echo "Sample hotspot data exported to apps/frontend/src/data/sample_hotspots.json"

# Open psql shell using DATABASE_URL (local or remote Azure DB)
db-psql *args:
    psql "$DATABASE_URL" "$@"

# Ensure named 'firms' database and extensions exist on server
db-setup:
    @MAINT_URL=$(echo "$DATABASE_URL" | sed -E 's|/[^/?]+(\?.*)?$|/postgres\1|'); \
    echo "Ensuring 'firms' database and extensions are provisioned..."; \
    psql "$MAINT_URL" -f sql/setup.sql

# Apply schema to named database using DATABASE_URL
db-schema:
    psql "$DATABASE_URL" -f sql/schema.sql

# Ingest Nicaragua dev dataset from Parquet into PostGIS via DuckDB
db-load-nicaragua:
    duckdb -dark-mode -f sql/load_nicaragua_sample.sql

# Full reset and reload of dev database
db-reset-load: db-schema db-load-nicaragua

# Auto-format and auto-fix pipeline code
format:
    uv run ruff format pipeline
    uv run ruff check --fix pipeline

# Lint pipeline code with ruff
lint:
    uv run ruff check pipeline

# Type-check pipeline code with basedpyright
typecheck:
    uv run basedpyright pipeline
