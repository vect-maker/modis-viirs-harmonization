FIRMS_MAP_KEY=your_firms_map_key_here

# Primary PostgreSQL / PostGIS connection URI
# Local Podman default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firms?sslmode=prefer

# For Azure PostgreSQL Flexible Server:
# DATABASE_URL=postgresql://admin:password@my-server.postgres.database.azure.com:5432/firms?sslmode=require

# Local Podman container initialization variables (only used by compose.yml on initial boot)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firms
POSTGRES_PORT=5432
